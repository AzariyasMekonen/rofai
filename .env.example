# Copy to .env and fill in. Never commit .env.

# --- Language model: "copilot" or "openai" (any OpenAI-compatible endpoint) ---
LLM_PROVIDER=copilot

# GitHub Copilot: fine-grained PAT (github_pat_...) owned by your personal account with the
# "Copilot Requests" account permission. Every visitor question uses this account's Copilot quota.
COPILOT_GITHUB_TOKEN=
# Leave empty for the runtime default model
COPILOT_MODEL=

# OpenAI-compatible (used when LLM_PROVIDER=openai)
# Azure OpenAI / Foundry: https://YOUR-RESOURCE.openai.azure.com/openai/v1/
# OpenAI:                 https://api.openai.com/v1
# Ollama (local):         http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
# On Azure this is your deployment name
LLM_MODEL=

# --- Embeddings (optional; without an endpoint the archive uses keyword search) ---
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# --- Azure AI Speech ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
TTS_VOICE_EN=en-US-AvaMultilingualNeural
TTS_VOICE_AM=am-ET-MekdesNeural
TTS_RATE=-3%
TTS_PITCH=+0%

# --- Persona ---
SCHOOL_NAME=
ASSISTANT_NAME=Mekdes
FOUNDER_NAME=Tsehay Roschli

# --- Web safety ---
# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_CHAT_PER_MINUTE=15
RATE_LIMIT_SPEECH_PER_MINUTE=60
