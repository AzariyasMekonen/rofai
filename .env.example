# Copy to .env and fill in. Never commit .env.

# --- Language model (any OpenAI-compatible endpoint) ---
# Azure OpenAI / Foundry: https://YOUR-RESOURCE.openai.azure.com/openai/v1/
# OpenAI:                 https://api.openai.com/v1
# Ollama (local):         http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
# On Azure this is your deployment name
LLM_MODEL=

# --- Embeddings (defaults to the LLM endpoint/key when left empty) ---
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# --- Azure AI Speech ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
TTS_VOICE_EN=en-US-AvaMultilingualNeural
TTS_VOICE_AM=am-ET-MekdesNeural
TTS_RATE=-8%
TTS_PITCH=-4%

# --- Persona ---
SCHOOL_NAME=
PERSONA_NAME=Tsehay Roschli

# --- Web safety ---
# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_CHAT_PER_MINUTE=15
RATE_LIMIT_SPEECH_PER_MINUTE=60
